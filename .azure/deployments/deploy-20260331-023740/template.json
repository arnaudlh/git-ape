{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploys an Azure Kubernetes Service (AKS) cluster with Azure CNI networking, Container Insights monitoring, system-assigned managed identity, and Azure RBAC for Kubernetes.",
    "deploymentId": "deploy-20260331-023740",
    "managedBy": "autocloud-agent"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "project": {
      "type": "string",
      "defaultValue": "k8s",
      "metadata": {
        "description": "Project name used in CAF-compliant resource naming."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "staging",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment."
      }
    },
    "kubernetesVersion": {
      "type": "string",
      "defaultValue": "1.30",
      "metadata": {
        "description": "Kubernetes version for the AKS cluster."
      }
    },
    "nodeCount": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Number of nodes in the system node pool."
      }
    },
    "nodeVmSize": {
      "type": "string",
      "defaultValue": "Standard_B2s",
      "metadata": {
        "description": "VM size for the system node pool nodes."
      }
    },
    "dnsZoneName": {
      "type": "string",
      "defaultValue": "k8s-dev.example.com",
      "metadata": {
        "description": "Public DNS zone name for Web Application Routing (e.g. 'myapp.contoso.com'). Replace with your actual domain — Azure will host the zone and WAR will create DNS records automatically."
      }
    }
  },
  "variables": {
    "rgName": "[format('rg-{0}-{1}-{2}', parameters('project'), parameters('environment'), parameters('location'))]",
    "tags": {
      "Environment": "[parameters('environment')]",
      "Project": "[parameters('project')]",
      "ManagedBy": "autocloud-agent",
      "CreatedDate": "2026-03-31"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[variables('rgName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2024-03-01",
      "name": "aksDeployment",
      "resourceGroup": "[variables('rgName')]",
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('rgName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "project": {
            "value": "[parameters('project')]"
          },
          "environment": {
            "value": "[parameters('environment')]"
          },
          "kubernetesVersion": {
            "value": "[parameters('kubernetesVersion')]"
          },
          "nodeCount": {
            "value": "[parameters('nodeCount')]"
          },
          "nodeVmSize": {
            "value": "[parameters('nodeVmSize')]"
          },
          "dnsZoneName": {
            "value": "[parameters('dnsZoneName')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "location": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "kubernetesVersion": {
              "type": "string"
            },
            "nodeCount": {
              "type": "int"
            },
            "nodeVmSize": {
              "type": "string"
            },
            "dnsZoneName": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            }
          },
          "variables": {
            "logWorkspaceName": "[format('log-{0}-{1}-{2}', parameters('project'), parameters('environment'), parameters('location'))]",
            "vnetName": "[format('vnet-{0}-{1}-{2}', parameters('project'), parameters('environment'), parameters('location'))]",
            "aksSubnetName": "snet-aks",
            "aksClusterName": "[format('aks-{0}-{1}-{2}', parameters('project'), parameters('environment'), parameters('location'))]",
            "dnsPrefix": "[format('aks-{0}-{1}', parameters('project'), parameters('environment'))]"
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[variables('logWorkspaceName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30
              }
            },
            {
              "type": "Microsoft.Network/virtualNetworks",
              "apiVersion": "2024-01-01",
              "name": "[variables('vnetName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "addressSpace": {
                  "addressPrefixes": [
                    "10.0.0.0/16"
                  ]
                },
                "subnets": [
                  {
                    "name": "[variables('aksSubnetName')]",
                    "properties": {
                      "addressPrefix": "10.0.0.0/22"
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Network/dnsZones",
              "apiVersion": "2018-05-01",
              "name": "[parameters('dnsZoneName')]",
              "location": "global",
              "tags": "[parameters('tags')]",
              "properties": {}
            },
            {
              "type": "Microsoft.ContainerService/managedClusters",
              "apiVersion": "2024-09-01",
              "name": "[variables('aksClusterName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "sku": {
                "name": "Base",
                "tier": "Free"
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
                "[resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName'))]"
              ],
              "properties": {
                "kubernetesVersion": "[parameters('kubernetesVersion')]",
                "dnsPrefix": "[variables('dnsPrefix')]",
                "enableRBAC": true,
                "aadProfile": {
                  "managed": true,
                  "enableAzureRBAC": true
                },
                "disableLocalAccounts": true,
                "networkProfile": {
                  "networkPlugin": "azure",
                  "networkPolicy": "azure",
                  "serviceCidr": "10.1.0.0/16",
                  "dnsServiceIP": "10.1.0.10"
                },
                "agentPoolProfiles": [
                  {
                    "name": "system",
                    "count": "[parameters('nodeCount')]",
                    "vmSize": "[parameters('nodeVmSize')]",
                    "osDiskSizeGB": 30,
                    "osDiskType": "Managed",
                    "osType": "Linux",
                    "osSKU": "AzureLinux",
                    "maxPods": 110,
                    "mode": "System",
                    "type": "VirtualMachineScaleSets",
                    "enableAutoScaling": false,
                    "vnetSubnetID": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('aksSubnetName'))]"
                  }
                ],
                "addonProfiles": {
                  "omsagent": {
                    "enabled": true,
                    "config": {
                      "logAnalyticsWorkspaceResourceID": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName'))]"
                    }
                  },
                  "azurepolicy": {
                    "enabled": true
                  }
                },
                "autoUpgradeProfile": {
                  "upgradeChannel": "stable"
                },
                "ingressProfile": {
                  "webAppRouting": {
                    "enabled": true,
                    "dnsZoneResourceIds": [
                      "[resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName'))]"
                    ]
                  }
                }
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('aksSubnetName')), resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName')), '4d97b98b-1d4f-4787-a291-c67834d212e7')]",
              "scope": "[format('Microsoft.Network/virtualNetworks/{0}/subnets/{1}', variables('vnetName'), variables('aksSubnetName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName'))]",
                "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4d97b98b-1d4f-4787-a291-c67834d212e7')]",
                "principalId": "[reference(resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName')), '2024-09-01').identityProfile.kubeletidentity.objectId]",
                "principalType": "ServicePrincipal"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName')), variables('aksClusterName'), 'befefa01-2a29-4197-83a8-272ff33ce314')]",
              "scope": "[format('Microsoft.Network/dnsZones/{0}', parameters('dnsZoneName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName'))]",
                "[resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'befefa01-2a29-4197-83a8-272ff33ce314')]",
                "principalId": "[reference(resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName')), '2024-09-01').ingressProfile.webAppRouting.identity.objectId]",
                "principalType": "ServicePrincipal"
              }
            }
          ],
          "outputs": {
            "aksClusterName": {
              "type": "string",
              "value": "[variables('aksClusterName')]"
            },
            "aksClusterId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName'))]"
            },
            "aksClusterFqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', variables('aksClusterName')), '2024-09-01').fqdn]"
            },
            "logWorkspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName'))]"
            },
            "vnetId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
            },
            "dnsZoneNameServers": {
              "type": "array",
              "value": "[reference(resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName')), '2018-05-01').nameServers]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[variables('rgName')]"
    },
    "deploymentName": {
      "type": "string",
      "value": "aksDeployment"
    }
  }
}
